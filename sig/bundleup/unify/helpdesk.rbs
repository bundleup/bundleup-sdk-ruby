module BundleUp
  module Unify
    class Helpdesk < Base
      type requester = {
        id: String?,
        name: String?,
        email: String?
      }

      type ticket = {
        id: String,
        title: String?,
        description: String?,
        status: String?,
        priority: String?,
        requester: requester?,
        url: String?,
        created_at: String?,
        updated_at: String?
      }

      type metadata = { next: String? }

      def tickets: (?Hash[Symbol, untyped] params) -> { data: Array[ticket], metadata: metadata }

      def ticket: (String ticket_id, ?Hash[Symbol, untyped] params) -> { data: ticket }

      private

      def blank?: (untyped) -> bool
    end
  end
end
